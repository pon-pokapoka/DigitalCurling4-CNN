# Writes OUTPUT, a header defining DIGITALCURLING_CLIENT_BUILD_ID: which code
# this client was built from. Run at every build (cmake -P) so it follows new
# commits without reconfiguring; the header is only rewritten when the ID
# changes, so an unchanged ID triggers no recompilation.
#
# Inputs (-D): SOURCE_DIR, OUTPUT, BUILD_ID_OVERRIDE (used as-is if not empty,
# e.g. from a Docker build, which has no .git).
#
# The ID is `git describe --tags --dirty --always` with the "g" before the
# commit hash removed: v2026.07-67-ga604b03 -> v2026.07-67-a604b03.
# A build with uncommitted changes to tracked files ends in -dirty.

if (BUILD_ID_OVERRIDE)
    set(build_id "${BUILD_ID_OVERRIDE}")
else()
    find_package(Git QUIET)
    set(build_id "")
    if (GIT_FOUND)
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" describe --tags --dirty --always
            OUTPUT_VARIABLE build_id
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET
            RESULT_VARIABLE git_result
        )
        if (NOT git_result EQUAL 0)
            set(build_id "")
        endif()
    endif()
    if (build_id STREQUAL "")
        set(build_id "unknown")
    endif()
endif()

string(REGEX REPLACE "-g([0-9a-f]+)(-dirty)?$" "-\\1\\2" build_id "${build_id}")

set(content "// Generated by src/build_id.cmake. Do not edit.\n#define DIGITALCURLING_CLIENT_BUILD_ID \"${build_id}\"\n")
set(tmp "${OUTPUT}.tmp")
file(WRITE "${tmp}" "${content}")
file(COPY_FILE "${tmp}" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${tmp}")
