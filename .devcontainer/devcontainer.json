{
    "name": "DigitalCurling4-CNN",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".",
        "args": {
            "CUDA_VERSION": "13.4.3",
            "UBUNTU_VERSION": "26.04",
            "TORCH_VERSION": "2.15.0",
            "TORCH_CUDA": "134",
            // Optional, off by default: set DC4_CLAUDE_CODE=1 in .devcontainer/local.env
            // (read by dev.sh) or in the environment VS Code starts from.
            "INSTALL_CLAUDE_CODE": "${localEnv:DC4_CLAUDE_CODE:0}"
        }
    },
    "runArgs": [
        "--gpus=all",
        "--shm-size=1g",
        "--name=dc4-cnn-dev"
    ],
    // Rootless Docker: container root == host user, so bind-mounted files keep
    // host ownership. With rootful Docker, switch to "ubuntu" and set
    // updateRemoteUserUID to true so the CLI remaps it to the host UID.
    "remoteUser": "root",
    "updateRemoteUserUID": false,
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "mounts": [
        "source=dc4-cnn-ccache,target=/home/ubuntu/.cache/ccache,type=volume",
        // Claude Code login/settings persist across container rebuilds
        "source=dc4-cnn-claude,target=/opt/claude-config,type=volume",
        // GitHub CLI login persists across container rebuilds
        "source=dc4-cnn-gh,target=/opt/gh-config,type=volume",
        // Personal git config (identity, URL rewrites, ...) persists across
        // rebuilds and stays out of the repo
        "source=dc4-cnn-git,target=/opt/git-config,type=volume"
        // The host ssh-agent is not mounted here, so the container starts without
        // one. dev.sh mounts it when DC4_SSH_AGENT=1 (see local.env.example);
        // VS Code forwards the agent by itself.
    ],
    "containerEnv": {
        "GH_CONFIG_DIR": "/opt/gh-config",
        "GIT_CONFIG_GLOBAL": "/opt/git-config/gitconfig"
    },
    "postCreateCommand": "cmake --fresh -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release",
    // If you set up commit signing, warn (non-fatally) when it would fail.
    // Silent for everyone else.
    "postStartCommand": ".devcontainer/setup-signing.sh --check",
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cmake-tools",
                "editorconfig.editorconfig"
            ],
            "settings": {
                "cmake.buildDirectory": "${workspaceFolder}/build",
                "cmake.generator": "Ninja",
                "clangd.arguments": ["--compile-commands-dir=${workspaceFolder}/build"]
            }
        }
    }
}
