# Personal dev container options. Copy to .devcontainer/local.env (not
# committed) and edit; .devcontainer/dev.sh reads it. Everything is off by
# default, so the container works without an SSH key, GitHub or Claude.
#
# VS Code "Reopen in Container" does not read this file: set DC4_CLAUDE_CODE
# in the environment VS Code starts from. VS Code forwards your ssh-agent
# by itself, so DC4_SSH_AGENT is only needed with dev.sh.

# Forward the host ssh-agent into the container (git over SSH, commit
# signing). The private key stays on the host, but any process in the
# container can use the agent while the container runs.
# After changing this: .devcontainer/dev.sh down && .devcontainer/dev.sh up
DC4_SSH_AGENT=0

# Install Claude Code in the image. Its login and settings live in the
# dc4-cnn-claude volume. After changing this: .devcontainer/dev.sh rebuild
DC4_CLAUDE_CODE=0

# Commit signing with your GitHub-registered SSH signing key needs
# DC4_SSH_AGENT=1; then run .devcontainer/setup-signing.sh once in the container.
